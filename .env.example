# Frontend env. Copy to .env.local. Everything is optional for local dev.
# The Anthropic key lives in server/.env, never here.

# Where next.config.ts proxies /api/* (server-side only)
BACKEND_URL=http://localhost:8787
# Leave empty to go through that proxy. Set to the backend URL to call it directly from the browser.
NEXT_PUBLIC_API_URL=
