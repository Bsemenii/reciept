# Copy to server/.env. This file never reaches the browser.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is faster; compare on your receipts
PARSE_MODEL=claude-opus-5-5
# 1 = /api/parse always returns the demo receipt, no key needed (offline backup)
MOCK_PARSE=0

PORT=8787
# Frontend origin(s), comma-separated. "*" while testing from phones on the LAN.
FRONTEND_ORIGIN=http://localhost:3000
# Receipts older than this are deleted hourly, 0 = keep forever (keep 0 on demo day: links made the day before must still open)
RETENTION_HOURS=0
# DB_PATH=server/data/split.db
